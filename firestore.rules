rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each device signs in anonymously and only ever touches its own
    // users/{uid} subtree. The Cloudflare Worker authenticates as a GCP
    // service account (IAM), which bypasses these rules entirely — it does
    // not need a matching rule here.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /scheduledAlerts/{alertId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
